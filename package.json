{
  "name": "kawther-creates",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kawther | creates - a private wellness journal",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node tests/e2e/live.mjs",
    "test:db": "node --test tests/integration/*.test.js",
    "test:failures": "node tests/e2e/failures.mjs",
    "test:live": "node tests/live/repo.live.mjs && node tests/e2e/live.mjs && node tests/e2e/responsive.mjs && node tests/e2e/ux.mjs",
    "test:ux": "node tests/e2e/ux.mjs",
    "test:duration": "node tests/e2e/duration.mjs",
    "test:responsive": "node tests/e2e/responsive.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "playwright-core": "^1.48.0",
    "vite": "^5.4.0"
  }
}