# Copy to .env (local) or add these in Vercel -> Project -> Settings -> Environment Variables.
# EVERYTHING BELOW IS BROWSER-VISIBLE (Vite inlines every VITE_* variable into the public bundle).
# Never put a secret in a VITE_ variable. See docs/SECURITY_DEPLOYMENT_CHECKLIST.md.

# Data backend. The app has one backend: real Supabase. Keep this set to "supabase" in production.
VITE_DATA_BACKEND=supabase

# Project Settings -> API. Project URL and the *anon/public* key ONLY.
# NEVER put the service_role key or a "secret" API key here, in any VITE_ variable, or anywhere in this repo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile SITE key (public). Leave empty until Turnstile is set up: then no token is sent.
# The Turnstile SECRET key is NOT an environment variable of this app: paste it ONLY into
# Supabase Dashboard -> Authentication -> Attack Protection (CAPTCHA). It must never appear in .env, the repo or Vercel.
VITE_TURNSTILE_SITE_KEY=
